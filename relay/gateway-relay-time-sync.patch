+from unittest.mock import patch
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "gateway" / "ble_host_modular"))
+fake = types.ModuleType("bgapi")
+class CommandError(Exception):
+    pass
+
+class CommandFailedError(CommandError):
+    def __init__(self, errorcode=1):
+        super().__init__(errorcode)
+        self.errorcode = errorcode
+
+fake.bglib = SimpleNamespace(CommandFailedError=CommandFailedError, CommandError=CommandError)
+fake_connector = types.ModuleType("bgapi.connector")
+fake_connector.ConnectorException = type("ConnectorException", (Exception,), {})
+sys.modules.setdefault("bgapi.connector", fake_connector)
+sys.modules.setdefault("bgapi", fake)
+from ble_central import BleCentral
+from models import ConnectionState
+from relay_protocol import parse_relay_source, parse_relay_status, RELAY_SOURCE_UUID, RELAY_STATUS_UUID
+
+
+class RelayTests(unittest.TestCase):
+    def setUp(self):
+        self.state = ConnectionState(1, "11:22:33:44:55:66", 0, "BSRelay_01",
+            cough_characteristic=20, cough_characteristic_properties=0x32,
+            environment_characteristic=21,
+            relay_source_characteristic=25, relay_status_characteristic=24,
+            time_characteristic=29, time_characteristic_properties=0x0a)
+        self.central = BleCentral.__new__(BleCentral)
+        self.central.connections = {1: self.state}
+        self.central.sequence = 0
+        self.central.session_id = "test"
+        self.messages, self.commands, self.closes = [], [], []
+        self.central._publish = self.messages.append
+        self.central.disconnect_connection = self.closes.append
+        self.central.start_scan = lambda: None
+        self.central.lib = SimpleNamespace(bt=SimpleNamespace(gatt=SimpleNamespace(
+            set_characteristic_notification=lambda *args: self.commands.append(("subscribe", args)),
+            send_characteristic_confirmation=lambda *args: self.commands.append(("confirm", args)),
+            read_characteristic_value=lambda *args: self.commands.append(("read", args)),
+            write_characteristic_value=lambda *args: self.commands.append(("write", args)),
+        )))
+
+    def identity(self):
+        self.central.on_gatt_characteristic_value(SimpleNamespace(
+            connection=1, characteristic=25, att_opcode=0x0b,
+            value=bytes([1, 0, 6, 5, 4, 3, 2, 1])))
+
+    def status(self, ready=True):
+        self.central.on_gatt_characteristic_value(SimpleNamespace(
+            connection=1, characteristic=24, att_opcode=0x1b,
+            value=struct.pack("<BBBBbbIIIH", 1, 3 if ready else 0,
+                              14 if ready else 12, 2, -65, -70, 10, 8, 0, 0)))
+
+    def test_uuid_matches_firmware_bytes(self):
+        import uuid
+        for number, value in [(7, RELAY_STATUS_UUID), (8, RELAY_SOURCE_UUID)]:
+            self.assertEqual(bytes([0x66,0x55,0x44,0x33,0x22,0x11,0x10,0x9e,
+                                    0x6d,0x4c,0x4b,0x7a,number,0,0xe0,0xb5]),
+                             uuid.UUID(value).bytes[::-1])
+
+    def test_identity_preserves_source_address(self):
+        self.identity()
+        envelope = self.central._next_envelope(self.state, "cough_event", "2026-11-12T00:00:00Z")
+        self.assertEqual("01:02:03:04:05:06", envelope["device"]["device_id"])
+        self.assertEqual(self.state.address, envelope["transport"]["relay_address"])
+        self.assertEqual(self.state.address, "11:22:33:44:55:66")
+
+    def test_unknown_source_rejected(self):
+        for bad in (b"", b"\x01\x00" + bytes(6), b"\x02\x00" + bytes(range(6))):
+            with self.assertRaises(ValueError): parse_relay_source(bad)
+
+    def test_read_identity_before_subscribing(self):
+        self.central._finish_characteristic_discovery(self.state)
+        self.assertEqual([("read", (1,25))], self.commands)
+        self.assertEqual("read_relay_source", self.state.phase)
+
+    def test_relay_uses_indications_original_node_uses_notifications(self):
+        self.central._enable_cough_notifications(self.state)
+        self.assertEqual(("subscribe", (1,20,1)), self.commands[-1])
+        self.identity()
+        self.central._enable_cough_notifications(self.state)
+        self.assertEqual(("subscribe", (1,20,2)), self.commands[-1])
+
+    def test_upstream_offline_is_reported_even_when_pi_connected(self):
+        self.identity(); self.state.phase = "running"
+        self.status(True); self.status(False)
+        self.assertEqual(["connected", "disconnected"], [m["status"] for m in self.messages])
+        self.assertEqual(-65, self.state.relay_status["source_rssi_dbm"])
+
+    def test_initial_status_during_subscription_is_not_lost(self):
+        self.identity(); self.state.phase = "enable_relay_status"
+        self.status(True)
+        self.assertEqual([], self.messages)
+        self.central.on_gatt_procedure_completed(SimpleNamespace(connection=1,result=0))
+        self.assertEqual("sync_time_connect", self.state.phase)
+        self.central.on_gatt_procedure_completed(SimpleNamespace(connection=1,result=0))
+        import time
+        self.central.on_gatt_characteristic_value(SimpleNamespace(connection=1,
+            characteristic=29,att_opcode=0x0b,value=int(time.time()).to_bytes(4,"little")))
+        self.central.on_gatt_procedure_completed(SimpleNamespace(connection=1,result=0))
+        self.assertEqual("connected", self.messages[-1]["status"])
+
+    def test_indication_preserves_payload_and_is_confirmed(self):
+        self.identity(); self.state.relay_upstream_ready = True
+        self.central.on_gatt_characteristic_value(SimpleNamespace(
+            connection=1, characteristic=20, att_opcode=0x1d,

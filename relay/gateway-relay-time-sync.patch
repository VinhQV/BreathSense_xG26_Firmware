@@ -0,0 +1,43 @@
+"""Versioned BreathSense relay metadata; payloads from the source stay unchanged."""
+from __future__ import annotations
+
+import struct
+TIME_SYNC_UUID = "-".join(["b5e00004", "7a4b", "4c6d", "9e10", "112233445566"])
+
+RELAY_STATUS_UUID = "-".join(["b5e00007", "7a4b", "4c6d", "9e10", "112233445566"])
+RELAY_SOURCE_UUID = "-".join(["b5e00008", "7a4b", "4c6d", "9e10", "112233445566"])
+
+
+def parse_relay_source(payload: bytes) -> tuple[str, int]:
+    if len(payload) != 8 or payload[0] != 1 or payload[1] not in range(6):
+        raise ValueError("Invalid relay source metadata")
+    address = ":".join(f"{octet:02x}" for octet in reversed(payload[2:]))
+    if address == "00:00:00:00:00:00":
+        raise ValueError("Relay source has not been selected")
+    return address, payload[1]
+
+
+def parse_relay_status(payload: bytes) -> dict:
+    if len(payload) != 20 or payload[0] != 1 or payload[1] > 3:
+        raise ValueError("Invalid relay status")
+    version, phase, flags, queued, source_rssi, gateway_rssi, rx, tx, lost, invalid = (
+        struct.unpack("<BBBBbbIIIH", payload)
+    )
+    return {
+        "version": version,
+        "phase": phase,
+        "source_ready": bool(flags & 2),
+        "gateway_connected": bool(flags & 4),
+        "confirmed_delivery": bool(flags & 8),
+        "pendant_fresh": bool(flags & 16),
+        "ai_fresh": bool(flags & 32),
+        "relay_clock_valid": bool(flags & 64),
+        "source_clock_synced": bool(flags & 128),
+        "queued": queued,
+        "source_rssi_dbm": None if source_rssi == 127 else source_rssi,
+        "gateway_rssi_dbm": None if gateway_rssi == 127 else gateway_rssi,
+        "received": rx,
+        "delivered": tx,
+        "dropped": lost,
+        "invalid_packets": invalid,
+    }

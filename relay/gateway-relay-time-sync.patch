+"""Occurrence-time history, unknown times, and migration of a real legacy DB."""
+from pathlib import Path
+import sqlite3
+import sys
+import tempfile
+import unittest
+from datetime import datetime, timezone
+from unittest.mock import patch
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "gateway"))
+from app.dao import Dao
+from app.event_processor import EventProcessor
+from app.fleet import Fleet
+
+SCHEMA = ROOT / "gateway/app/schema.sql"
+
+
+class TimeStorageTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.path = Path(self.temp.name) / "history.db"
+        self.dao = Dao(str(self.path))
+        self.dao.init_db(str(SCHEMA))
+        self.processor = EventProcessor(self.dao, Fleet(self.dao))
+
+    def tearDown(self):
+        self.dao.close()
+        self.temp.cleanup()
+
+    def message(self, known=True, counter=1):
+        return dict(event="cough_event", message_id=f"time-{counter}", session_id="test",
+            device_id="aa:bb:cc:dd:ee:ff", client_id="patient",
+            received_at="2026-11-12T03:05:00.000Z",
+            event_ts="2026-11-12T03:00:00.000Z" if known else None,
+            parsed=dict(event_counter=counter, cough_type=1,
+                        timestamp_valid=known, event_timestamp=1794452400 if known else 0,
+                        timestamp_source="node_unix_seconds" if known else "unknown_unsynchronized"))
+
+    def test_cough_time_and_receive_time_are_stored_separately(self):
+        self.processor.process(self.message())
+        row = self.dao.get_recent_events()[0]
+        self.assertEqual("2026-11-12T03:00:00.000Z", row["event_ts"])
+        self.assertEqual("2026-11-12T03:05:00.000Z", row["received_ts"])
+        # Selecting 10:00 includes the delayed event; selecting 10:05 does not.
+        self.assertEqual(1, len(self.dao.get_events(client_id="patient", start_time="2026-11-12T03:00:00.000Z",
+                                                  end_time="2026-11-12T03:00:01.000Z")))
+        self.assertEqual([], self.dao.get_events(client_id="patient", start_time="2026-11-12T03:04:00.000Z",
+                                                end_time="2026-11-12T03:06:00.000Z"))
+
+    def test_unknown_time_remains_null_after_database_restart(self):
+        self.processor.process(self.message(False))
+        row = self.dao.get_recent_events()[0]
+        self.assertIsNone(row["event_ts"])
+        self.assertEqual("unknown_unsynchronized", row["timestamp_source"])
+        self.dao.close()
+        self.dao.init_db(str(SCHEMA))
+        row = self.dao.get_recent_events()[0]
+        self.assertIsNone(row["event_ts"])
+        self.assertEqual("2026-11-12T03:05:00.000Z", row["received_ts"])
+        self.assertEqual([], self.dao.get_events(client_id="patient", start_time="2026-11-12T00:00:00.000Z"))
+
+    def test_legacy_not_null_schema_migrates_with_rows_indexes_and_sequence(self):
+        self.dao.close()
+        legacy = Path(self.temp.name) / "legacy.db"
+        con = sqlite3.connect(legacy)
+        sql = SCHEMA.read_text().replace("event_ts             TEXT,", "event_ts             TEXT NOT NULL,")
+        con.executescript(sql)
+        con.execute("INSERT INTO devices(device_id) VALUES ('old')")
+        con.execute("INSERT INTO cough_events(id,device_id,event_ts,received_ts) VALUES (9,'old','old-time','receive-time')")
+        con.execute("CREATE INDEX custom_cough_index ON cough_events(event_counter)")
+        con.execute("UPDATE sqlite_sequence SET seq=99 WHERE name='cough_events'")
+        con.commit(); con.close()
+        self.dao = Dao(str(legacy))
+        self.dao.init_db(str(SCHEMA))
+        row = self.dao.get_recent_events()[0]
+        self.assertEqual(9, row["id"])
+        self.assertEqual("old-time", row["event_ts"])
+        self.assertTrue(self.dao.conn.execute(
+            "SELECT 1 FROM sqlite_master WHERE name='custom_cough_index'").fetchone())
+        self.processor = EventProcessor(self.dao, Fleet(self.dao))
+        self.processor.process(self.message(False))
+        unknown = self.dao.get_recent_events()[0]
+        # Ordering of legacy free-text dates is immaterial; inspect by message.
+        unknown = self.dao.conn.execute("SELECT * FROM cough_events WHERE message_id='time-1'").fetchone()
+        self.assertIsNone(unknown["event_ts"])
+        self.assertGreater(unknown["id"], 99)
+        self.assertEqual([], self.dao.conn.execute("PRAGMA foreign_key_check").fetchall())
+        self.dao.close()
+        self.dao.init_db(str(SCHEMA))
+        self.assertIsNone(self.dao.conn.execute(
+            "SELECT event_ts FROM cough_events WHERE message_id='time-1'").fetchone()[0])
+
+    def test_hourly_chart_uses_occurrence_hour_and_omits_unknown(self):
+        early = self.message()
+        early["event_ts"] = "2026-11-12T02:59:00.000Z"
+        early["parsed"]["event_timestamp"] = 1794452340
+        self.processor.process(early)
+        self.processor.process(self.message(False, 2))
+        with patch("app.dao.datetime") as clock:
+            clock.now.return_value = datetime(2026,11,12,4,tzinfo=timezone.utc)
+            buckets = self.dao.get_hourly_counts("patient")
+        self.assertEqual([dict(time_bucket="2026-11-12 02:00:00",cough_type="dry",count=1)], buckets)
+
+
+if __name__ == "__main__":
+    unittest.main()

+    def _allow_unknown_cough_time(self) -> None:
+        """Remove the legacy NOT NULL constraint without losing rows/indexes."""
+        conn = self._get_conn()
+        columns = conn.execute("PRAGMA table_info(cough_events)").fetchall()
+        if not any(row["name"] == "event_ts" and row["notnull"] for row in columns):
+            return
+        original = conn.execute(
+            "SELECT sql FROM sqlite_master WHERE type='table' AND name='cough_events'"
+        ).fetchone()[0]
+        nullable = re.sub(r"\bevent_ts\s+TEXT\s+NOT\s+NULL\b", "event_ts TEXT", original,
+                          count=1, flags=re.IGNORECASE)
+        if nullable == original:
+            raise RuntimeError("Unsupported cough_events timestamp schema; migration stopped")
+        create_sql = nullable.replace("cough_events", "cough_events_time_v2", 1)
+        objects = conn.execute(
+            "SELECT sql FROM sqlite_master WHERE tbl_name='cough_events' "
+            "AND type IN ('index','trigger') AND sql IS NOT NULL"
+        ).fetchall()
+        fields = ", ".join('"' + row["name"].replace('"', '""') + '"' for row in columns)
+        sequence = conn.execute("SELECT seq FROM sqlite_sequence WHERE name='cough_events'").fetchone()
+        conn.execute("SAVEPOINT migrate_cough_time")
+        try:
+            conn.execute(create_sql)
+            conn.execute(f"INSERT INTO cough_events_time_v2 ({fields}) SELECT {fields} FROM cough_events")
+            conn.execute("DROP TABLE cough_events")
+            conn.execute("ALTER TABLE cough_events_time_v2 RENAME TO cough_events")
+            if sequence:
+                conn.execute("UPDATE sqlite_sequence SET seq=MAX(seq,?) WHERE name='cough_events'",
+                             (sequence[0],))
+            for obj in objects:
+                conn.execute(obj[0])
+            conn.execute("RELEASE SAVEPOINT migrate_cough_time")
+        except Exception:
+            conn.execute("ROLLBACK TO SAVEPOINT migrate_cough_time")
+            conn.execute("RELEASE SAVEPOINT migrate_cough_time")
+            raise
+
     @staticmethod
     def _rows(cursor: sqlite3.Cursor) -> list[dict[str, Any]]:
         return [dict(row) for row in cursor.fetchall()]

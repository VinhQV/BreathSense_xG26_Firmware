+        self.assertEqual("01:02:03:04:05:06", self.messages[-1]["device"]["device_id"])
+        self.assertIsNone(self.messages[-1]["event_ts"])
+        self.assertEqual("unknown_unsynchronized",
+                         self.messages[-1]["parsed"]["timestamp_source"])
+        self.assertEqual(("confirm",(1,)), self.commands[-1])
+
+    def test_source_timestamp_is_preserved_if_trustworthy(self):
+        from datetime import datetime, timezone
+        self.identity(); self.state.relay_upstream_ready = True
+        timestamp = int(datetime.now(timezone.utc).timestamp())
+        self.central.on_gatt_characteristic_value(SimpleNamespace(
+            connection=1, characteristic=20, att_opcode=0x1d,
+            value=struct.pack("<BBIH",1,1,timestamp,124)))
+        self.assertEqual("node_unix_seconds", self.messages[-1]["parsed"]["timestamp_source"])
+
+    def test_queued_event_does_not_leave_offline_source_online(self):
